# ───────── Sitio ─────────
SITE_URL=https://tudominio.com.ar
SUPPORT_EMAIL=hola@tudominio.com.ar
NEXT_PUBLIC_WHATSAPP=549XXXXXXXXXX
# Datos del vendedor (obligatorios por Ley 24.240: aparecen en el pie y los términos)
SELLER_NAME="Nombre y apellido o razón social"
SELLER_CUIT=20-00000000-0
SELLER_ADDRESS="Calle 123, Ciudad, Provincia"
SHOW_TESTIMONIALS=false

# ───────── Precios (ARS) ─────────
FRONT_PRICE_ARS=9900
REGULAR_PRICE_ARS=14900
# Fecha REAL de fin del precio de lanzamiento (después rige REGULAR_PRICE_ARS)
LAUNCH_PRICE_UNTIL=2026-11-30T23:59:59-03:00
COMBO_DISCOUNT=0.33
DOWNSELL_FACTOR=0.5

# ───────── Mercado Pago ─────────
# Tus integraciones → tu aplicación → Credenciales de producción (Access Token APP_USR-...)
MP_ACCESS_TOKEN=
# Tus integraciones → Webhooks → URL https://tudominio.com.ar/api/webhooks/mercadopago, evento "Pagos" → clave secreta
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=AGENDERA
MP_MAX_INSTALLMENTS=3

# ───────── Entrega ─────────
# openssl rand -hex 32
DOWNLOAD_SECRET=
# JSON clave→URL de cada ZIP. Se genera con: npm run upload:blob (Vercel Blob) o pegá links de Drive/Dropbox.
DOWNLOAD_URLS={}
# Resend (resend.com): verificar el dominio y crear API key
RESEND_API_KEY=
EMAIL_FROM="Agendera <hola@tudominio.com.ar>"

# ───────── Meta ─────────
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → tu Pixel → Configuración → API de Conversiones → Generar token
META_CAPI_TOKEN=
# Solo para probar: código de "Probar eventos"
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v23.0
# Panel /admin: token con permiso ads_read (usuario del sistema en Business Manager) + ID de cuenta publicitaria
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=

# ───────── Panel ─────────
# Clave para entrar a /admin?key=...
ADMIN_KEY=
# Costos para el panel (ver docs/05-medicion-escalamiento.md)
MP_FEE_RATE=0.0649
SALES_TAX_RATE=0
AD_PROVINCIAL_RATE=0
COUNT_RG5617_AS_COST=false

# ───────── Solo desarrollo local ─────────
# Simula pagos aprobados sin Mercado Pago (no funciona en producción)
ALLOW_DEMO=false
